{
  "name": "dsh-calendar-coach",
  "version": "0.4.4",
  "description": "日历 + 每日 DDL + 准时提醒 + 每日教练：DSH Web 界面里的日历页签与浮动卡（公历/农历、纪念日与百天里程碑、A+B+C 三种提醒），并把 dsh-daily-coach 0.2 的打卡/复盘/笔记/计划合进同一个插件。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "zzq4546-arch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzq4546-arch/dsh-daily-coach.git"
  },
  "bugs": {
    "url": "https://github.com/zzq4546-arch/dsh-daily-coach/issues"
  },
  "homepage": "https://github.com/zzq4546-arch/dsh-daily-coach#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "calendar",
    "reminder",
    "lunar",
    "daily-coach"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
